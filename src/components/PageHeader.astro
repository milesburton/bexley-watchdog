---
// Shared page-header pattern (kicker + h1 + intro paragraph) used across
// most top-level pages. The intro is a slot rather than a string prop
// because some pages need inline links/formatting inside it.
interface Props {
	kicker: string;
	title: string;
	introMaxWidth?: string;
}

const { kicker, title, introMaxWidth = '60ch' } = Astro.props;
---

<header class="page-header">
	<p class="kicker">{kicker}</p>
	<h1>{title}</h1>
	{Astro.slots.has('intro') && (
		<p class="intro" style={{ '--intro-max-width': introMaxWidth }}>
			<slot name="intro" />
		</p>
	)}
	<slot />
</header>

<style>
	.page-header {
		margin-bottom: 2.5rem;
	}

	.kicker {
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-strong);
		font-size: 0.78rem;
		font-weight: 600;
		margin: 0 0 0.75rem;
	}

	h1 {
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		margin: 0;
	}

	.intro {
		margin-top: 0.85rem;
		max-width: var(--intro-max-width, 60ch);
		color: var(--text-muted);
		line-height: 1.6;
	}

	.intro :global(a) {
		color: var(--accent-strong);
		text-decoration: none;
	}

	.intro :global(a:hover) {
		text-decoration: underline;
	}
</style>
